# ===== Backend (Spring Boot) =====
# Salin ke environment Anda atau `export` sebelum menjalankan backend.
# JANGAN commit file .env asli.

SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manga_reader
DB_USERNAME=postgres
DB_PASSWORD=ganti-dengan-password-lokal

# JWT — WAJIB diisi saat produksi (minimal 256 bit / 32 karakter acak).
# Generate: openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=720
# Hanya untuk pengembangan lokal; biarkan false kecuali Anda paham risikonya.
APP_JWT_ALLOW_INSECURE_DEV_SECRET=false

# Jikan API v4 (metadata manga)
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_TIMEOUT_SECONDS=10

# ===== Frontend (Vite) =====
# Letakkan di frontend/.env (salin baris di bawah)
VITE_API_BASE_URL=http://localhost:8080
